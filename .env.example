# ─────────────────────────────────────────────────────────────
# PipeVision — Environment Configuration Template (.env)
# ─────────────────────────────────────────────────────────────
# IMPORTANT:
# - Development defaults below are strictly for local development.
# - Production deployment REQUIRES explicit, non-default configuration:
#   1. Set ENVIRONMENT=production and DEBUG=false
#   2. Production REQUIRES a strong database password (POSTGRES_PASSWORD)
#   3. Production REQUIRES explicit non-wildcard CORS/host configurations
#   4. Production REQUIRES actual AI model paths/checkpoints (or explicit null engine flag)
# ─────────────────────────────────────────────────────────────

# Application Lifecycle (Use ENVIRONMENT=production and DEBUG=false in production)
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (Postgres / PostGIS)
# NOTE: In production, do NOT use default credentials or local connection URLs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_in_production
POSTGRES_DB=pipevision
DATABASE_URL=postgresql+psycopg://postgres:postgres_dev_password_change_in_production@localhost:5432/pipevision
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# AI Model Configuration
# NOTE: In production, ensure valid trained model weights exist at SEWER_CHECKPOINT_PATH.
SEWER_CHECKPOINT_PATH=experiments/sewer/E009/best.pt
SEWER_THRESHOLDS_PATH=experiments/sewer/E009/thresholds.json
ALLOW_NULL_SEWER_ENGINE=false
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# Storage & File System Paths
MEDIA_IMPORT_ROOT=data/import
MEDIA_STORAGE_ROOT=data/frames

# Security & CORS
# NOTE: Wildcard CORS_ORIGINS=["*"] or ALLOWED_HOSTS=["*"] are strictly rejected in production.
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SECRET_KEY=change-me-in-production-use-strong-secret

# Raspberry Pi 4 servo control (opt-in; hardware is never driven at startup)
ROBOT_TRANSPORT_TYPE=simulator
ROBOT_DRY_RUN=true
ROBOT_HARDWARE_ENABLED=false
ROBOT_GPIO_ENABLED=false
# Set ROBOT_GPIO_ENABLED=true and ROBOT_DRY_RUN=false only on the Pi.
# Configure every channel's pin, calibration, and optional command_scale for
# the actual wiring. Do not copy pin or angle values from another robot.
# Example shape (replace every null with deployment-specific values):
# {"locomotion_1":{"gpio_pin":null,"neutral_deg":null,"min_deg":null,"max_deg":null,"command_scale":null}}
ROBOT_SERVO_CONFIG_JSON=
# Reserved for a future Raspberry Pi ↔ Pico controller link.
ROBOT_PICO_UART_ENABLED=false
ROBOT_PICO_UART_PORT=
ROBOT_PICO_UART_BAUDRATE=115200
ROBOT_PICO_UART_TIMEOUT_S=1.0
# MPU6050 is optional and disabled by default. Enable only after wiring and
# verifying the I2C bus/address; raw samples are exposed as telemetry IMU data.
ROBOT_MPU6050_ENABLED=false
ROBOT_MPU6050_I2C_BUS=1
ROBOT_MPU6050_I2C_ADDRESS=0x68
ROBOT_MPU6050_ACCELEROMETER_SCALE_G=2
ROBOT_MPU6050_GYROSCOPE_SCALE_DPS=250

# Camera source: simulator keeps existing stored/placeholder behavior.
# For an ESP32-CAM, supply the exact firmware stream endpoint or snapshot endpoint on the local LAN.
CAMERA_SOURCE_TYPE=simulator
ESP32_CAM_URL=
ESP32_CAM_SNAPSHOT_URL=
ESP32_CAM_TIMEOUT_S=3.0

# Generic local software-generated gas sensor settings
GAS_SENSOR_ENABLED=true
GAS_SENSOR_INTERVAL_S=1
GAS_SENSOR_MIN=0
GAS_SENSOR_MAX=100

# Processing & Resource Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_BATCH_IMAGE_COUNT=500
MAX_BATCH_VIDEO_SIZE_BYTES=524288000
WEBSOCKET_HEARTBEAT_INTERVAL_S=30.0
